# Local Ollama is the default provider; no API key is needed.
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_NUM_CTX=16384
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Set LLM_PROVIDER=anthropic and provide a key to use the original course model.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219
