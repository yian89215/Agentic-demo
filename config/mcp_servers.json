{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${PROJECT_ROOT}/data"
      ]
    },
    "research": {
      "command": "${PYTHON}",
      "args": [
        "${PROJECT_ROOT}/src/mcp_demo/servers/research_server.py"
      ],
      "env": {
        "PAPERS_DIR": "${PAPERS_DIR}"
      }
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp<2",
        "mcp-server-fetch"
      ]
    }
  }
}
